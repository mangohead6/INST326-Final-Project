# Jose's function
def available_choices(choices, points, history):
    if points < 0:
        raise ValueError("Points cannot be negative")

    available = {}

    for choice in choices:
        required_history, min_points = choices[choice]

        if points >= min_points:
            allowed = True

            for past_choice in required_history:
                if past_choice not in history:
                    allowed = False

            if allowed:
                available[choice] = choices[choice]

    return available

# Jacob's function
def apply_choice(choice, choices, choices_results, points, history):
    """Apply a choice's effects and updates points and history.

    Args:
        choice (str): the choice the player picked
        choices (dict): choice name points to (required history list, min points)
        choices_results (dict): choice name points to list of (effect type, adder)
        points (int): player's current points
        history (list): past choices

    Returns:
        tuple: (new_history, new_points), or ([], 0) if the player dies (total reset)

    Raises:
        ValueError: if points are negative or the choice is not available or DNE
    """
    if points < 0:
        raise ValueError("Points cannot be negative")
    
    if choice not in choices or choice not in available_choices(choices, points, history) :
        raise ValueError("This is not a valid choice")
    
    new_history = history.copy()
    new_history.append(choice)
    new_points = points
    
    for type, adder in choices_results[choice]:
        if type == "points":
            new_points += adder
        elif type == "minigame":
            new_points += run_minigame(adder)
        if new_points <= 0:
            return [], 0
            
    return(new_history,new_points)

